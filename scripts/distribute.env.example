# Sao chép thành scripts/distribute.env (đã được .gitignore) rồi điền.
# Mọi giá trị ở đây đều có thể ghi đè bằng biến môi trường khi chạy script.

# Project Firebase dùng chung với app chess.
FIREBASE_PROJECT_ID=chess-app-chauvb

# App ID Android của Nonopix (dạng 1:540704428434:android:...).
# Để trống thì script tự tìm theo package com.chauvb.nonogram (và đề nghị tạo
# app nếu chưa có).
FIREBASE_APP_ID=

# Người nhận bản build: nhóm tester (alias trong Firebase) và/hoặc email.
FIREBASE_TESTER_GROUPS=
FIREBASE_TESTERS=

# Tài khoản Google cho firebase CLI, khi máy đăng nhập nhiều tài khoản.
FIREBASE_ACCOUNT=
